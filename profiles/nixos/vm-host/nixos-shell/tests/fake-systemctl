#!/usr/bin/env bash
set -euo pipefail

: "${FAKE_SYSTEMCTL_LOG:?}"
: "${FAKE_VM_HOST:?}"
: "${NIXOS_SHELL_IMAGE_ROOT:?}"

printf '%s\n' "$*" >>"$FAKE_SYSTEMCTL_LOG"

if [ "$1" = start ] && [ "${2:-}" = "${FAKE_VM_HOST}-image.service" ]; then
    if [ "${FAKE_SYSTEMCTL_FAIL_IMAGE:-false}" = true ]; then
      exit 1
    fi

    candidate="${NIXOS_SHELL_IMAGE_ROOT}/fake-candidate"
    mkdir -p "$candidate/bin"
    printf '#!/usr/bin/env bash\nexit 0\n' >"$candidate/bin/run-${FAKE_VM_HOST}-vm"
    chmod +x "$candidate/bin/run-${FAKE_VM_HOST}-vm"
    ln -sfn "$candidate" "${NIXOS_SHELL_IMAGE_ROOT}/current"
elif [ "$1" = restart ] && [ "${2:-}" = "${FAKE_VM_HOST}-vm.service" ]; then
    if [ "${FAKE_SYSTEMCTL_FAIL_RESTART:-false}" = true ]; then
      exit 1
    fi
else
  echo "unexpected fake systemctl invocation: $*" >&2
  exit 64
fi
