{ config, pkgs, ... }:

{
#  environment.systemPackages = with pkgs; [
#    font-awesome
#  ];

fonts = {
  enableDefaultPackages = true;
  packages = with pkgs; [
    font-awesome
    font-awesome_6
    powerline-fonts
    nerdfonts
    terminus_font
  ];

  fontconfig.defaultFonts = {
    monospace = [ "FontAwesome" "Terminus" "FontAwesome" "DejaVuSansMono Nerd Font" ];
    sansSerif = [ "FontAwesome" ];
    serif = [ "FontAwesome" ];
  };
};

}

