            { config, pkgs, ... }: {
              #############################
              # Bootloader and Kernel Options
              #############################
              boot.loader.systemd-boot.enable = true;
              boot.loader.efi.canTouchEfiVariables = true;
              boot.extraModprobeConfig = "options kvm_intel nested=1";
              #boot.initrd.systemd.enable = true;
              boot.loader.systemd-boot.configurationLimit = 10;

              boot.initrd.availableKernelModules = [ "tpm_tis" "tpm_crb" "nvme" "sd_mod" ];
              #boot.initrd.kernelModules = [ "i915" ];
              boot.initrd.systemd.enable = true;
              #boot.initrd.systemd.enableTpm2 = true;
              security.tpm2.enable = true;
              fileSystems."/".options = [ "noatime" ];
              boot.initrd.luks.devices.cryptroot = {
                device = "/dev/disk/by-uuid/4ecc7f7e-9796-42f1-a49e-020e52e2109b";
                #preLVM = true;            # true if LVM is inside LUKS (omit if not using LVM)
                allowDiscards = true;     # enable TRIM on SSD (optional)
                # No keyFile is set, so by default systemd will prompt or use tokens.
                #crypttabExtraOpts = [ "tpm2-device=auto" ];
              };
}
