{
  description = "Migrated NixOS configuration into a full flake";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-24.11";
    lanzaboote = {
      url = "github:nix-community/lanzaboote/v0.4.2";

      # Optional but recommended to limit the size of your system closure.
      inputs.nixpkgs.follows = "nixpkgs";
    };
    #nixpkgs.url = "github:NixOS/nixpkgs/nixos-stable"; # This points to the latest stable branch
  };

  outputs = { self, nixpkgs, lanzaboote, ... }: {
    nixosConfigurations = {
      nixos = nixpkgs.lib.nixosSystem {
        system = "x86_64-linux";
        modules = [
          #./hardware-configuration.nix
          #./nvidia.nix
          #./bootloader.nix
          #./network-basics.nix
          #./locale-settings.nix
          #./desktop-environment.nix
          #./audio-and-bluetooth.nix
          #./users-and-groups.nix
          #./packages-and-applications.nix
          #./virtualization-lxc.nix
          #./virtualization-general.nix
          #./autoupdate.nix
          #./gc.nix
          #./shell-env.nix
          #./autologin.nix
# ls /etc/nixos | grep 'nix$' | grep -v flake | grep -v 'secboot' | sed 's/^/.\//g' # secboot has still errors                        [2:39:17]
./audio-and-bluetooth.nix
#./autologin.nix
./autoupdate.nix
./bootloader.nix
./desktop-environment.nix
./gc.nix
./hardware-configuration.nix
./locale-settings.nix
./network-basics.nix
./nvidia.nix
#./hardware-firewall.nix
./packages-and-applications.nix
./shell-env.nix
./users-and-groups.nix
./virtualization-general.nix
./virtualization-lxc.nix

          /* lanzaboote.nixosModules.lanzaboote

          ({ pkgs, lib, ... }: {

            environment.systemPackages = [
              # For debugging and troubleshooting Secure Boot.
              pkgs.sbctl
            ];

            # Lanzaboote currently replaces the systemd-boot module.
            # This setting is usually set to true in configuration.nix
            # generated at installation time. So we force it to false
            # for now.
            boot.loader.systemd-boot.enable = lib.mkForce false;

            boot.lanzaboote = {
              enable = true;
              pkiBundle = "/var/lib/sbctl";
            };
          })

	  */

          # config based off:
          (
            { config, pkgs, ... }: {
              #############################
              # System State Version
              #############################
              system.stateVersion = "24.11";
            }
          )
        ];
      };
    };
  };
}

