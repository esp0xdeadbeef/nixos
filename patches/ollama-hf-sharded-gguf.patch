@@ -1244,0 +1265,188 @@ func pullModelManifest(ctx context.Context, n model.Name, regOpts *registryOptio
+var hfHubBaseURL = "https://huggingface.co"
+
+type hfSibling struct {
+	Rfilename string `json:"rfilename"`
+	LFS       *struct {
+		SHA256 string `json:"sha256"`
+		Size   int64  `json:"size"`
+	} `json:"lfs"`
+}
+
+type hfGGUFShard struct {
+	filename string
+	digest   string
+	size     int64
+	prefix   string
+	index    uint16
+	count    uint16
+}
+
+func isHFHost(host string) bool {
+	return host == "hf.co" || host == "huggingface.co"
+}
+
+func pullHFShardedManifest(ctx context.Context, n model.Name, regOpts *registryOptions) (*manifest.Manifest, []byte, error) {
+	base, err := url.Parse(hfHubBaseURL)
+	if err != nil {
+		return nil, nil, fmt.Errorf("hf sharded manifest: invalid Hub URL: %w", err)
+	}
+	apiURL := base.JoinPath("api", "models", n.DisplayNamespaceModel())
+	query := apiURL.Query()
+	query.Set("blobs", "true")
+	apiURL.RawQuery = query.Encode()
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, apiURL.String(), nil)
+	if err != nil {
+		return nil, nil, fmt.Errorf("hf sharded manifest: %w", err)
+	}
+	req.Header.Set("User-Agent", fmt.Sprintf("ollama/%s (%s %s) Go/%s", version.Version, runtime.GOARCH, runtime.GOOS, runtime.Version()))
+	if regOpts != nil && regOpts.Token != "" {
+		req.Header.Set("Authorization", "Bearer "+regOpts.Token)
+	} else if regOpts != nil && regOpts.Username != "" && regOpts.Password != "" {
+		req.SetBasicAuth(regOpts.Username, regOpts.Password)
+	}
+
+	client := &http.Client{}
+	if regOpts != nil {
+		client.CheckRedirect = regOpts.CheckRedirect
+	}
+	resp, err := client.Do(req)
+	if err != nil {
+		return nil, nil, fmt.Errorf("hf sharded manifest: %w", err)
+	}
+	defer resp.Body.Close()
+
+	if resp.StatusCode != http.StatusOK {
+		body, _ := io.ReadAll(resp.Body)
+		return nil, nil, fmt.Errorf("hf sharded manifest: %d: %s", resp.StatusCode, body)
+	}
+
+	var modelInfo struct {
+		Siblings []hfSibling `json:"siblings"`
+	}
+	if err := json.NewDecoder(resp.Body).Decode(&modelInfo); err != nil {
+		return nil, nil, fmt.Errorf("hf sharded manifest: decode: %w", err)
+	}
+
+	prefix := n.Tag + "/"
+	var shards []hfGGUFShard
+	for _, sibling := range modelInfo.Siblings {
+		if !strings.HasPrefix(sibling.Rfilename, prefix) ||
+			!strings.HasSuffix(strings.ToLower(sibling.Rfilename), ".gguf") ||
+			sibling.LFS == nil || sibling.LFS.SHA256 == "" {
+			continue
+		}
+
+		namePrefix, index, count, ok := splitGGUFName(sibling.Rfilename)
+		if !ok {
+			continue
+		}
+		shards = append(shards, hfGGUFShard{
+			filename: sibling.Rfilename,
+			digest:   "sha256:" + sibling.LFS.SHA256,
+			size:     sibling.LFS.Size,
+			prefix:   namePrefix,
+			index:    index,
+			count:    count,
+		})
+	}
+
+	if len(shards) == 0 {
+		return nil, nil, fmt.Errorf("hf sharded manifest: no GGUF shards found for tag %q in %s", n.Tag, n.DisplayNamespaceModel())
+	}
+	slices.SortFunc(shards, func(a, b hfGGUFShard) int {
+		return int(a.index) - int(b.index)
+	})
+
+	expectedPrefix := shards[0].prefix
+	expectedCount := shards[0].count
+	if len(shards) != int(expectedCount) {
+		return nil, nil, fmt.Errorf("hf sharded manifest: found %d shards for tag %q, expected %d", len(shards), n.Tag, expectedCount)
+	}
+
+	layers := make([]manifest.Layer, len(shards))
+	for i, shard := range shards {
+		if shard.prefix != expectedPrefix || shard.count != expectedCount || int(shard.index) != i {
+			return nil, nil, fmt.Errorf("hf sharded manifest: inconsistent shard set for tag %q", n.Tag)
+		}
+		layers[i] = manifest.Layer{
+			MediaType: "application/vnd.ollama.image.model",
+			Digest:    shard.digest,
+			Size:      shard.size,
+			From:      shard.filename,
+		}
+	}
+
+	mf := &manifest.Manifest{
+		SchemaVersion: 2,
+		MediaType:     "application/vnd.docker.distribution.manifest.v2+json",
+		Layers:        layers,
+	}
+	data, err := json.Marshal(mf)
+	if err != nil {
+		return nil, nil, fmt.Errorf("hf sharded manifest: encode: %w", err)
+	}
+
+	slog.Info("assembled sharded GGUF manifest from Hugging Face Hub",
+		"model", n.DisplayNamespaceModel(), "tag", n.Tag, "shards", len(shards))
+	return mf, data, nil
+}
+
+func pulledSplitGGUFFiles(mf *manifest.Manifest) (map[string]string, bool, error) {
+	var modelLayers []manifest.Layer
+	for _, layer := range mf.Layers {
+		if layer.MediaType == "application/vnd.ollama.image.model" {
+			modelLayers = append(modelLayers, layer)
+		}
+	}
+	if len(modelLayers) < 2 {
+		return nil, false, nil
+	}
+
+	files := make(map[string]string, len(modelLayers))
+	var expectedPrefix string
+	var expectedCount uint16
+	for i, layer := range modelLayers {
+		prefix, index, count, ok := splitGGUFName(layer.From)
+		if !ok {
+			return nil, false, nil
+		}
+		if i == 0 {
+			expectedPrefix = prefix
+			expectedCount = count
+		}
+		if prefix != expectedPrefix || count != expectedCount || int(index) != i {
+			return nil, false, fmt.Errorf("inconsistent split GGUF manifest")
+		}
+		filename := filepath.Base(layer.From)
+		if _, exists := files[filename]; exists {
+			return nil, false, fmt.Errorf("duplicate split GGUF shard %q", filename)
+		}
+		files[filename] = layer.Digest
+	}
+	if len(files) != int(expectedCount) {
+		return nil, false, fmt.Errorf("split GGUF manifest has %d shards, expected %d", len(files), expectedCount)
+	}
+	return files, true, nil
+}
+
+func importPulledSplitGGUF(n model.Name, mf *manifest.Manifest, fn func(api.ProgressResponse)) (bool, error) {
+	files, ok, err := pulledSplitGGUFFiles(mf)
+	if err != nil || !ok {
+		return false, err
+	}
+
+	baseLayers, err := convertModelFromFiles(files, nil, false, fn)
+	if err != nil {
+		return true, err
+	}
+
+	config := &model.ConfigV2{
+		OS:           runtime.GOOS,
+		Architecture: runtime.GOARCH,
+		RootFS:       model.RootFS{Type: "layers"},
+	}
+	req := api.CreateRequest{Model: n.String()}
+	return true, createModel(req, n, baseLayers, config, fn)
+}
+
