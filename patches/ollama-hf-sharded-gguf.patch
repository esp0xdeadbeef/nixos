+
+func TestPullHFShardedManifestFallback(t *testing.T) {
+	const (
+		firstDigest  = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
+		secondDigest = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
+	)
+
+	ts := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		switch {
+		case strings.HasPrefix(r.URL.Path, "/v2/"):
+			w.WriteHeader(http.StatusBadRequest)
+			fmt.Fprint(w, `{"error":"repository contains sharded GGUF"}`)
+		case r.URL.Path == "/api/models/test/model":
+			if r.URL.Query().Get("blobs") != "true" {
+				t.Fatal("missing blobs=true query")
+			}
+			fmt.Fprintf(w, `{"siblings":[
+				{"rfilename":"IQ2/model-00002-of-00002.gguf","lfs":{"sha256":%q,"size":20}},
+				{"rfilename":"unrelated.gguf","lfs":{"sha256":%q,"size":1}},
+				{"rfilename":"IQ2/model-00001-of-00002.gguf","lfs":{"sha256":%q,"size":10}}
+			]}`, secondDigest, firstDigest, firstDigest)
+		default:
+			http.NotFound(w, r)
+		}
+	}))
+	defer ts.Close()
+
+	originalBaseURL := hfHubBaseURL
+	hfHubBaseURL = ts.URL
+	t.Cleanup(func() {
+		hfHubBaseURL = originalBaseURL
+	})
+
+	testHost := strings.TrimPrefix(ts.URL, "http://")
+	testMakeRequestDialContext = func(ctx context.Context, network, _ string) (net.Conn, error) {
+		return (&net.Dialer{}).DialContext(ctx, network, testHost)
+	}
+	t.Cleanup(func() {
+		testMakeRequestDialContext = nil
+	})
+
+	n := model.ParseName("hf.co/test/model:IQ2")
+	n.ProtocolScheme = "http"
+	mf, data, err := pullModelManifest(t.Context(), n, &registryOptions{Insecure: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(data) == 0 {
+		t.Fatal("synthetic manifest data is empty")
+	}
+	if len(mf.Layers) != 2 {
+		t.Fatalf("layers = %d, want 2", len(mf.Layers))
+	}
+	if got := mf.Layers[0].Digest; got != "sha256:"+firstDigest {
+		t.Fatalf("first digest = %q", got)
+	}
+	if got := mf.Layers[0].From; got != "IQ2/model-00001-of-00002.gguf" {
+		t.Fatalf("first source filename = %q", got)
+	}
+	if got := mf.Layers[1].Digest; got != "sha256:"+secondDigest {
+		t.Fatalf("second digest = %q", got)
+	}
+
+	files, ok, err := pulledSplitGGUFFiles(mf)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !ok {
+		t.Fatal("synthetic manifest was not recognized as split GGUF")
+	}
+	if len(files) != 2 {
+		t.Fatalf("files = %d, want 2", len(files))
+	}
+}
