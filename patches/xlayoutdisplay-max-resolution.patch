diff -ruN xlayoutdisplay-old/src/DisplayRules.cpp xlayoutdisplay-new/src/DisplayRules.cpp
--- xlayoutdisplay-old/src/DisplayRules.cpp	1970-01-01 01:00:00.000000000 +0100
+++ xlayoutdisplay-new/src/DisplayRules.cpp	2026-06-25 02:58:42.437440311 +0200
@@ -0,0 +1,130 @@
+/*
+   Local xlayoutdisplay extensions.
+*/
+#include "DisplayRules.h"
+#include "util.h"
+
+#include <algorithm>
+#include <cmath>
+#include <regex>
+#include <strings.h>
+
+using namespace std;
+
+static bool parseModeSize(const string &mode, unsigned int *width, unsigned int *height) {
+    smatch match;
+    if (!regex_match(mode, match, regex("([0-9]+)x([0-9]+)")) || match.size() != 3) {
+        return false;
+    }
+
+    *width = static_cast<unsigned int>(stoul(match[1]));
+    *height = static_cast<unsigned int>(stoul(match[2]));
+    return true;
+}
+
+static bool parseScale(const string &scale, double *scaleX, double *scaleY) {
+    smatch match;
+    if (!regex_match(scale, match, regex("([0-9]+(\\.[0-9]+)?)x([0-9]+(\\.[0-9]+)?)")) || match.size() != 5) {
+        return false;
+    }
+
+    *scaleX = stod(match[1]);
+    *scaleY = stod(match[3]);
+    return *scaleX > 0 && *scaleY > 0;
+}
+
+OutputScale parseOutputScale(const string &value) {
+    smatch match;
+    if (!regex_match(value, match, regex("([^=]+)=(\\S+)")) || match.size() != 3) {
+        throw invalid_argument("invalid scale: " + value);
+    }
+
+    OutputScale scale;
+    scale.selector = match[1];
+    scale.scale = match[2];
+    return scale;
+}
+
+bool outputMatches(const string &selector, const shared_ptr<Output> &output) {
+    if (strcasecmp(selector.c_str(), output->name.c_str()) == 0) {
+        return true;
+    }
+
+    const string edidPrefix = "edid:";
+    if (strncasecmp(selector.c_str(), edidPrefix.c_str(), edidPrefix.size()) == 0) {
+        const string wanted = selector.substr(edidPrefix.size());
+        return output->edid && strcasecmp(wanted.c_str(), output->edid->hash().c_str()) == 0;
+    }
+
+    return false;
+}
+
+void applyOutputScales(const list<shared_ptr<Output>> &outputs, const vector<OutputScale> &scales) {
+    for (const auto &scale : scales) {
+        for (const auto &output : outputs) {
+            if (outputMatches(scale.selector, output)) {
+                double scaleX;
+                double scaleY;
+                if (!parseScale(scale.scale, &scaleX, &scaleY)) {
+                    throw invalid_argument("invalid scale '" + scale.scale + "'");
+                }
+
+                output->desiredScaleConfigured = true;
+                output->desiredScaleX = scaleX;
+                output->desiredScaleY = scaleY;
+            }
+        }
+    }
+}
+
+shared_ptr<const Mode> desiredModeForOutput(const Output &output, const string &maxMode) {
+    unsigned int maxWidth;
+    unsigned int maxHeight;
+    if (maxMode.empty() || output.name.rfind("eDP", 0) == 0 || !parseModeSize(maxMode, &maxWidth, &maxHeight)) {
+        return output.optimalMode;
+    }
+
+    for (const auto &mode : reverseSort(output.modes)) {
+        if (mode->width <= maxWidth && mode->height <= maxHeight) {
+            return mode;
+        }
+    }
+
+    return output.optimalMode;
+}
+
+void applyTargetResolutionScale(Output &output, const string &targetResolution) {
+    unsigned int targetWidth;
+    unsigned int targetHeight;
+    if (targetResolution.empty() || output.desiredScaleConfigured || !output.desiredMode ||
+        !parseModeSize(targetResolution, &targetWidth, &targetHeight)) {
+        return;
+    }
+
+    const double scaleX = static_cast<double>(targetWidth) / output.desiredMode->width;
+    const double scaleY = static_cast<double>(targetHeight) / output.desiredMode->height;
+    const double scale = min(scaleX, scaleY);
+    if (scale >= 1.0) {
+        return;
+    }
+
+    output.desiredScaleConfigured = true;
+    output.desiredScaleX = scale;
+    output.desiredScaleY = scale;
+}
+
+int logicalOutputWidth(const Output &output) {
+    if (!output.desiredMode) {
+        return 0;
+    }
+
+    return static_cast<int>(ceil(output.desiredMode->width * output.desiredScaleX));
+}
+
+int logicalOutputHeight(const Output &output) {
+    if (!output.desiredMode) {
+        return 0;
+    }
+
+    return static_cast<int>(ceil(output.desiredMode->height * output.desiredScaleY));
+}
