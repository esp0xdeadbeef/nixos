+static pair<int, int> frameBufferDimensions(const list<shared_ptr<Output>> &outputs) {
+    int width = 0;
+    int height = 0;
+
+    for (const auto &output : outputs) {
+        if (!output->desiredActive || !output->desiredMode || !output->desiredPos) {
+            continue;
+        }
+
+        width = max(width, output->desiredPos->x + static_cast<int>(output->desiredMode->width));
+        height = max(height, output->desiredPos->y + static_cast<int>(output->desiredMode->height));
+    }
+
+    return make_pair(width, height);
+}
