+TEST(xrandrutil_renderXrandrCmd, renderScaledOutput) {
+    list<shared_ptr<Output>> outputs;
+
+    shared_ptr<Mode> mode1 = make_shared<Mode>(1, 3840, 2160, 60);
+    shared_ptr<Output> output1 = make_shared<Output>("DP-1", Output::connected, list<shared_ptr<const Mode>>({mode1}),
+                                                     mode1, mode1, make_shared<Pos>(0, 0), shared_ptr<Edid>());
+    output1->desiredActive = true;
+    output1->desiredMode = mode1;
+    output1->desiredPos = make_shared<Pos>(0, 0);
+    output1->desiredScaleConfigured = true;
+    output1->desiredScaleX = 0.666667;
+    output1->desiredScaleY = 0.666667;
+    outputs.push_back(output1);
+
+    stringstream expected;
+    expected << "xrandr \\\n";
+    expected << " --dpi 96 --fb 2561x1441 \\\n";
+    expected << " --output DP-1 --mode 3840x2160 --rate 60 --pos 0x0 --scale 0.666667x0.666667 --primary";
+
+    EXPECT_EQ(expected.str(), renderXrandrCmd(outputs, output1, 96, 60));
+}
