@@ -25,0 +27,24 @@
+static bool parseModeSize(const string &mode, unsigned int *width, unsigned int *height) {
+    smatch match;
+    if (!regex_match(mode, match, regex("([0-9]+)x([0-9]+)")) || match.size() != 3) {
+        return false;
+    }
+
+    *width = static_cast<unsigned int>(stoul(match[1]));
+    *height = static_cast<unsigned int>(stoul(match[2]));
+    return true;
+}
+
+static shared_ptr<const Mode> cappedOptimalMode(const Output &output, const string &maxMode) {
+    unsigned int maxWidth;
+    unsigned int maxHeight;
+    if (maxMode.empty() || !parseModeSize(maxMode, &maxWidth, &maxHeight)) {
+        return output.optimalMode;
+    }
+
+    for (const auto &mode : reverseSort(output.modes))
+        if (mode->width <= maxWidth && mode->height <= maxHeight)
+            return mode;
+    return output.optimalMode;
+}
+
@@ -82,0 +108,4 @@
