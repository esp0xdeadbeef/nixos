#!/usr/bin/env bash
set -euo pipefail

# Protected production pins are a commit-time gate, not a CI one: the prod and
# legacy-prod network shapes are what a live site runs on, and the whole point is
# that a bump cannot leave this workstation without someone approving it. The
# snapshot in ci/prod-pins.lock makes the change an explicit diff in the commit.
if git diff --cached --name-only -- flake.lock | grep -qx flake.lock; then
  scripts/check-prod-pins.sh
fi

mapfile -d '' changed < <(
  git diff --cached --name-only --diff-filter=ACMR -z -- '*.nix'
)

[ ${#changed[@]} -eq 0 ] && exit 0

echo "[hook] formatting staged nix files..."

nix shell nixpkgs#nixfmt nixpkgs#nix --command bash <<'EOF'
set -euo pipefail

while IFS= read -r -d '' f; do
    [ -f "$f" ] || continue
    nixfmt "$f"
done

git add -- "${files[@]}" 2>/dev/null || true

echo "[hook] parsing staged nix files..."

while IFS= read -r -d '' f; do
    [ -f "$f" ] || continue
    nix-instantiate --parse "$f" >/dev/null
done
EOF

