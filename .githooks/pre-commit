#!/usr/bin/env bash
set -euo pipefail

changed=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.nix$' || true)
[ -z "$changed" ] && exit 0

nix shell nixpkgs#nixfmt-rfc-style nixpkgs#nix \
  --command bash -euo pipefail -c '

changed='"$(printf "%q " $changed)"'

echo "[hook] formatting staged nix files..."
for f in $changed; do
    [ -f "$f" ] || continue
    nixfmt "$f"
done

git add $changed 2>/dev/null || true

echo "[hook] parsing staged nix files..."
for f in $changed; do
    [ -f "$f" ] || continue
    nix-instantiate --parse "$f" >/dev/null
done

echo "[hook] done"
'

