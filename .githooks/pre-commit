#!/usr/bin/env bash
set -euo pipefail

mapfile -d '' changed < <(
  git diff --cached --name-only --diff-filter=ACMR -z -- '*.nix'
)

[ ${#changed[@]} -eq 0 ] && exit 0

echo "[hook] formatting staged nix files..."

nix shell nixpkgs#nixfmt-rfc-style nixpkgs#nix --command bash <<'EOF'
set -euo pipefail

while IFS= read -r -d '' f; do
    [ -f "$f" ] || continue
    nixfmt "$f"
done

git add -- "${files[@]}" 2>/dev/null || true

echo "[hook] parsing staged nix files..."

while IFS= read -r -d '' f; do
    [ -f "$f" ] || continue
    nix-instantiate --parse "$f" >/dev/null
done
EOF

