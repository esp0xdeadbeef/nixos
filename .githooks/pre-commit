#!/usr/bin/env bash
set -euo pipefail

# Commit-time guards for encrypted material and protected surfaces:
#
#  * check-sops-encrypted.sh: a secrets file must actually be ciphertext. A
#    plaintext value in the tree decrypts "fine" because there is nothing to
#    decrypt, and the secret is already public.
#  * check-sops-recipients.sh: a secrets file must be encrypted to the keys that
#    are supposed to read it.
#  * check-prod-paths.sh: the CONTENT of the protected paths
#    (prod-network/prod/, prod-network/current/, the *-prod / *-legacy-prod
#    host configs and secrets) is read-only without explicit per-session
#    permission naming the exact files.
#  * check-prod-pins.sh: the *flake.lock pins* of the prod and legacy-prod
#    network shapes cannot move without an approved snapshot diff.
scripts/check-sops-encrypted.sh --staged

scripts/check-prod-paths.sh --staged
scripts/check-sops-recipients.sh

if git diff --cached --name-only -- flake.lock | grep -qx flake.lock; then
  scripts/check-prod-pins.sh
fi

mapfile -d '' changed < <(
  git diff --cached --name-only --diff-filter=ACMR -z -- '*.nix'
)

[ ${#changed[@]} -eq 0 ] && exit 0

echo "[hook] formatting staged nix files..."

nix shell nixpkgs#nixfmt nixpkgs#nix --command bash <<'EOF'
set -euo pipefail

while IFS= read -r -d '' f; do
    [ -f "$f" ] || continue
    nixfmt "$f"
done

git add -- "${files[@]}" 2>/dev/null || true

echo "[hook] parsing staged nix files..."

while IFS= read -r -d '' f; do
    [ -f "$f" ] || continue
    nix-instantiate --parse "$f" >/dev/null
done
EOF

