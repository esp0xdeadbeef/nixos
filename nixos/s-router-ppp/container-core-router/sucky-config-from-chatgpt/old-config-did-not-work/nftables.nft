
flush ruleset

############################
# FILTER
############################
table inet filter {

  set wan_if {
    type ifname
    flags dynamic
    elements = { "ppp0" }
  }

  set lan_if {
    type ifname
    flags dynamic
    elements = { "lan1010" }
  }

  chain input {
    type filter hook input priority 0;
    policy drop;

    # DHCPv6 client/server on WAN
    iifname "ppp0" udp sport 547 udp dport 546 accept
    iifname "ppp0" udp sport 546 udp dport 547 accept

    # DHCPv6 server on LAN (PD to downstream routers)
    iifname "lan1010" udp dport 547 accept
    iifname "lan1010" udp sport 547 udp dport 546 accept

    # All-nodes DHCPv6
    ip6 daddr ff02::1:2 udp dport 547 accept

    # ICMP / ICMPv6 (mandatory for IPv6 routing)
    ip protocol icmp accept
    ip6 nexthdr icmpv6 accept

    iif lo accept
    ct state established,related accept

    ip6 nexthdr icmpv6 icmpv6 type {
      echo-request,
      echo-reply,
      nd-neighbor-solicit,
      nd-neighbor-advert,
      nd-router-solicit,
      nd-router-advert,
      packet-too-big,
      time-exceeded,
      parameter-problem
    } accept
  }

  chain forward {
    type filter hook forward priority 0;
    policy drop;

    ct state established,related accept
    iifname @lan_if oifname @wan_if accept
    iifname @wan_if oifname @lan_if accept

    ip6 nexthdr icmpv6 icmpv6 type {
      echo-request,
      echo-reply,
      nd-neighbor-solicit,
      nd-neighbor-advert,
      nd-router-solicit,
      nd-router-advert,
      packet-too-big,
      time-exceeded,
      parameter-problem
    } accept
  }

  chain output {
    type filter hook output priority 0;
    policy accept;
  }
}

############################
# NAT (IPv4 only)
############################
table ip nat {
  chain postrouting {
    type nat hook postrouting priority 100;
    oifname "ppp0" masquerade
  }
}

