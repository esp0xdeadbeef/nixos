
table ip nat {
  # example for portforwarding:
  chain prerouting {
    type nat hook prerouting priority dstnat; policy accept;
    iifname "lan1010" tcp dport 5555 dnat to 192.168.1.196:5555
  }

  #chain postrouting {
  #  type nat hook postrouting priority srcnat; policy accept;
  #  oifname "lan1010" ip saddr 192.168.1.0/24 masquerade
  #}
}

table ip6 nat {
  chain prerouting {
    type nat hook prerouting priority dstnat; policy accept;
    iifname "lan1010" tcp dport 5555 dnat ip6 to [2a10:3781:59de:0:3eb2:ea7c:cf5c:a1f6]:5555
  }
}





table inet filter {
      chain input {
            type filter hook input priority 0;
            policy drop;

            # Loopback
            iif lo accept

            iifname { "lan2", "lan3", "lan10", "lan1000" } fib daddr type local udp dport 53 accept
            iifname { "lan2", "lan3", "lan10", "lan1000" } fib daddr type local tcp dport 53 accept

            # Established / related
            ct state established,related accept


            # --- ICMP ---
            ip protocol icmp accept
            ip6 nexthdr icmpv6 accept

            # --- DHCPv6 client (ISP) ---
            iifname "lan1010" udp sport 547 udp dport 546 accept

            # --- EXPLICIT DNS BLOCK ON WAN (LOG + DROP, VALID) ---
            iifname "lan1010" udp dport 53 log prefix "DROP_DNS_UDP_WAN: "
            iifname "lan1010" udp dport 53 drop


            iifname "lan1010" tcp dport 53 log prefix "DROP_DNS_TCP_WAN: "
            iifname "lan1010" tcp dport 53 drop


            # --- BLOCK ALL OTHER UDP FROM WAN ---
            iifname "lan1010" meta l4proto udp log prefix "DROP_UDP_WAN: "
            iifname "lan1010" meta l4proto udp drop


            # --- BLOCK ALL OTHER TCP FROM WAN ---
            iifname "lan1010" meta l4proto tcp log prefix "DROP_TCP_WAN: "
            iifname "lan1010" meta l4proto tcp drop
      }


      chain forward {
            type filter hook forward priority 0;
            policy drop;

            ct state established,related accept


            # accept a temp rule (port forward):
            iifname "lan1010" ip daddr 192.168.1.196 tcp dport 5555 accept

            # LAN → WAN (all LANs)
            iifname { "lan2", "lan3", "lan10", "lan1000"} oifname "lan1010" accept

            # WAN → LAN denied
            iifname "lan1010" log prefix "DROP_FWD_PPP0: "
            iifname "lan1010" drop
      }


      chain output {
            type filter hook output priority 0;
            policy accept;
      }
}

