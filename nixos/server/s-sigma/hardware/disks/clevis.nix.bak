{ config, pkgs, ... }:

{
  boot.initrd.systemd.enable = true;
  boot.initrd.network.enable = true;
  boot.initrd.clevis.enable = true;


  # Include clevis + tools
  boot.initrd.systemd.initrdBin = with pkgs; [
    coreutils
    iproute2
    cryptsetup
    clevis
    curl
    jq
  ];

  # Network for initrd
  boot.initrd.systemd.network.networks."10-eno4" = {
    matchConfig.Name = "eno4";
    networkConfig = {
      Address = "192.168.1.196/24";
      Gateway = "192.168.1.1";
      DNS = "192.168.1.1";
    };
  };

  boot.initrd.luks.devices."crypted" = {
    device = "/dev/disk/by-uuid/d05a14b3-1b49-4dc1-884c-784d48569839";

    preLVMCommands = ''
      set -eux

      echo "[initrd] Waiting for network..."
      for i in $(seq 1 30); do
        ip route | grep -q default && break
        sleep 0.2
      done

      echo "[initrd] Attempting clevis unlock"

      if /bin/clevis decrypt < /boot/clevis/crypted.jwe | \
           /sbin/cryptsetup open /dev/disk/by-uuid/d05a14b3-1b49-4dc1-884c-784d48569839 crypted --key-file=-; then
        echo "[initrd] Clevis unlock successful"
        exit 0
      fi

      echo "[initrd] Clevis failed, falling back to passphrase"
    '';
  };

  boot.initrd.clevis.devices."/dev/nvme0n1p1".secretFile = ./nvme0n1p1.jwe;

  # Ensure initrd has network requirement
  boot.kernelParams = [ "rd.neednet=1" ];
}
