+static int as21xxx_config_aneg(struct phy_device *phydev)
+{
+	/* The self-booted firmware already configures and runs copper
+	 * autoneg (advertising all supported speeds). The generic
+	 * genphy_c45_config_aneg() that phylib would otherwise call reads the
+	 * ability/advertisement registers with single C45 reads, which return
+	 * the previously addressed register on these pipelined units; it then
+	 * writes that stale value back, corrupting the advertisement and
+	 * dropping the copper link as soon as phylink connects the PHY. Leave
+	 * the firmware's autoneg configuration untouched. */
+	return 0;
