+		clk_disable_unprepare(mpcs->sgmii_rx);
+	}
+
 	mpcs->interface = PHY_INTERFACE_MODE_NA;
+	if (mpcs->xfi_tphy) {
+		cancel_delayed_work_sync(&mpcs->link_poll);
+		phy_power_off(mpcs->xfi_tphy);
+	}
