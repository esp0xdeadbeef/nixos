+		clk_prepare_enable(mpcs->sgmii_rx);
+		clk_prepare_enable(mpcs->sgmii_tx);
+	}
+
+	if (mpcs->xfi_tphy) {
+		phy_power_on(mpcs->xfi_tphy);
+		schedule_delayed_work(&mpcs->link_poll, HZ);
+	}
+
+	return 0;
+}
