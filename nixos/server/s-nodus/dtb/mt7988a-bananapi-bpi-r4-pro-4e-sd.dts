			interrupt-names = "fe0", "fe1", "fe2", "fe3", "pdma0", "pdma1", "pdma2", "pdma3";
			clocks = <0x2e 0x08 0x2e 0x03 0x2e 0x04 0x2e 0x05 0x2e 0x06 0x22 0x00 0x22 0x01 0x22 0x02 0x2e 0x07 0x03 0x22 0x03 0x4b 0x03 0x4c 0x03 0x4d 0x03 0x4e 0x03 0x66 0x03 0x1e 0x03 0x1f 0x03 0x24 0x03 0x61 0x03 0x64 0x03 0x65 0x2e 0x00 0x2e 0x01 0x2e 0x02>;
			clock-names = "crypto", "fe", "gp2", "gp1", "gp3", "ethwarp_wocpu2", "ethwarp_wocpu1", "ethwarp_wocpu0", "esw", "top_eth_gmii_sel", "top_eth_refck_50m_sel", "top_eth_sys_200m_sel", "top_eth_sys_sel", "top_eth_xgmii_sel", "top_eth_mii_sel", "top_netsys_sel", "top_netsys_500m_sel", "top_netsys_pao_2x_sel", "top_netsys_sync_250m_sel", "top_netsys_ppefb_250m_sel", "top_netsys_warp_sel", "xgp1", "xgp2", "xgp3";
			assigned-clocks = <0x03 0x20 0x03 0x21 0x03 0x41 0x03 0x42 0x03 0x43 0x03 0x45>;
			assigned-clock-parents = <0x15 0x05 0x03 0x0f 0x03 0x15 0x03 0x15 0x15 0x07 0x15 0x07>;
			sram = <0x2f>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			mediatek,ethsys = <0x2e>;
			mediatek,infracfg = <0x1f>;
			pinctrl-0 = <0x30>;
			pinctrl-names = "default";
			status = "okay";
			phandle = <0x6d>;

			mac@0 {
				compatible = "mediatek,eth-mac";
				reg = <0x00>;
				phy-mode = "internal";
				status = "okay";
				phandle = <0x27>;

				fixed-link {
					speed = <0x2710>;
					full-duplex;
					pause;
				};
			};

			mac@1 {
				compatible = "mediatek,eth-mac";
				reg = <0x01>;
				/* WAN = USXGMII1 -> the sfp2 cage (vendor "-sfp" board
				   overlay).  Vendor-exact WAN binding: in-band status +
				   10gbase-r + sfp2.  The vendor ships a "-iphy" overlay
				   for the 2.5G RJ45 WAN instead. */
				status = "okay";
				managed = "in-band-status";
				phy-mode = "10gbase-r";
				phy-connection-type = "10gbase-r";
				pcs-handle = <0x81 0x85>;
				sfp = <0x78>;
				phandle = <0x6e>;
			};

			mac@2 {
				compatible = "mediatek,eth-mac";
				reg = <0x02>;
				status = "okay";
				phy-mode = "10gbase-r";
				phy-connection-type = "10gbase-r";
				pcs-handle = <0x83 0x84>;
				phandle = <0x35>;

				fixed-link {
					speed = <0x2710>;
					full-duplex;
				};
			};

			mdio-bus {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				phandle = <0x6f>;

				ethernet-phy@15 {
					compatible = "ethernet-phy-ieee802.3-c45";
					reg = <0x0f>;
					status = "disabled";
					phandle = <0x70>;
				};

				switch@16 {
					compatible = "maxlinear,mxl86252";
					reg = <0x10>;
					dsa,member = <0x00 0x00>;
					status = "okay";

					ports {
						#address-cells = <0x01>;
						#size-cells = <0x00>;

						port@1 {
							reg = <0x01>;
							label = "mxl_lan0";
							phy-handle = <0x31>;
							phy-mode = "internal";
							status = "okay";
						};

						port@2 {
							reg = <0x02>;
							label = "mxl_lan1";
							phy-handle = <0x32>;
							phy-mode = "internal";
							status = "okay";
						};

						port@3 {
							reg = <0x03>;
							label = "mxl_lan2";
							phy-handle = <0x33>;
							phy-mode = "internal";
							status = "okay";
						};

						port@4 {
							reg = <0x04>;
							label = "mxl_lan3";
							phy-handle = <0x34>;
							phy-mode = "internal";
							status = "okay";
						};

						port@9 {
							reg = <0x09>;
							label = "cpu";
							phy-mode = "usxgmii";
							ethernet = <0x35>;

							fixed-link {
								speed = <0x2710>;
								full-duplex;
							};
						};

						port@13 {
							reg = <0x0d>;
							label = "mxl_lan5";
							phy-mode = "usxgmii";
							managed = "in-band-status";
							sfp = <0x36>;
							status = "okay";
						};
					};

					mdio {
						#address-cells = <0x01>;
						#size-cells = <0x00>;

						switchphy@0 {
							reg = <0x00>;
							phandle = <0x31>;
						};

						switchphy@1 {
							reg = <0x01>;
							phandle = <0x32>;
						};

						switchphy@2 {
							reg = <0x02>;
							phandle = <0x33>;
						};

						switchphy@3 {
							reg = <0x03>;
							phandle = <0x34>;
						};
					};
				};
			};
		};

		sram@15400000 {
			compatible = "mmio-sram";
			reg = <0x00 0x15400000 0x00 0x200000>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			ranges = <0x00 0x15400000 0x00 0x200000>;
			phandle = <0x2f>;
		};
	};

	thermal-zones {

		cpu-thermal {
			polling-delay-passive = <0x3e8>;
			polling-delay = <0x3e8>;
			thermal-sensors = <0x37 0x00>;
			phandle = <0x71>;

			trips {

				crit {
					temperature = <0x1e848>;
					hysteresis = <0x7d0>;
					type = "critical";
					phandle = <0x72>;
				};

				hot {
					temperature = <0x1d4c0>;
					hysteresis = <0x7d0>;
					type = "hot";
					phandle = <0x73>;
				};

				active-high {
					temperature = <0x1c138>;
					hysteresis = <0x7d0>;
					type = "active";
					phandle = <0x39>;
				};

				active-med {
					temperature = <0x14c08>;
					hysteresis = <0x7d0>;
					type = "active";
					phandle = <0x3a>;
				};

				active-low {
					temperature = <0x9c40>;
					hysteresis = <0x7d0>;
					type = "active";
					phandle = <0x3b>;
				};
			};

			cooling-maps {

				map-cpu-active-high {
					cooling-device = <0x38 0x03 0x03>;
					trip = <0x39>;
				};

				map-cpu-active-med {
					cooling-device = <0x38 0x02 0x02>;
					trip = <0x3a>;
				};

				map-cpu-active-low {
					cooling-device = <0x38 0x01 0x01>;
					trip = <0x3b>;
				};
			};
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <0x01>;
		interrupts = <0x01 0x0d 0x08 0x01 0x0e 0x08 0x01 0x0b 0x08 0x01 0x0a 0x08>;
	};

	aliases {
		ethernet0 = "/soc/ethernet@15100000/mac@0";
		i2c0 = "/soc/i2c@11003000";
		i2c1 = "/soc/i2c@11004000";
		i2c2 = "/soc/i2c@11005000";
		i2c3 = "/soc/i2c@11005000/i2c-mux@70/i2c@0";
		i2c4 = "/soc/i2c@11005000/i2c-mux@70/i2c@1";
		i2c5 = "/soc/i2c@11005000/i2c-mux@70/i2c@2";
		i2c6 = "/soc/i2c@11005000/i2c-mux@70/i2c@3";
	};

	chosen {
		stdout-path = "/soc/serial@11000000";
	};

	pwm-fan {
		compatible = "pwm-fan";
		cooling-levels = <0x00 0x50 0x80 0xff>;
		pinctrl-0 = <0x3c>;
		pinctrl-names = "default";
		pwms = <0x3d 0x00 0xc350>;
		#cooling-cells = <0x02>;
		phandle = <0x38>;
	};

	gpio-keys {
		compatible = "gpio-keys";

		button-reset {
			label = "reset";
			gpios = <0x08 0x0d 0x01>;
			linux,code = <0x198>;
		};

		button-wps {
			label = "WPS";
			gpios = <0x08 0x0e 0x01>;
			linux,code = <0x211>;
		};
	};

	gpio-leds {
		compatible = "gpio-leds";

		sys-led-red {
			color = <0x01>;
			function = "fault";
			gpios = <0x3e 0x0f 0x00>;
			phandle = <0x74>;
		};

		sys-led-blue {
			color = <0x03>;
			function = "activity";
			gpios = <0x3e 0x0e 0x00>;
			phandle = <0x75>;
		};
	};

	regulator-dvdd1v8 {
		compatible = "regulator-fixed";
		regulator-name = "DVDD1V8_SOC";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		regulator-boot-on;
		regulator-always-on;
		phandle = <0x76>;
	};

	regulator-3v3vd {
		compatible = "regulator-fixed";
		regulator-name = "3V3VD";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		regulator-boot-on;
		regulator-always-on;
		phandle = <0x77>;
	};

	sfp1 {
		compatible = "sff,sfp";
		i2c-bus = <0x3f>;
		los-gpios = <0x08 0x46 0x00>;
		mod-def0-gpios = <0x08 0x45 0x01>;
		tx-disable-gpios = <0x08 0x15 0x00>;
		maximum-power-milliwatt = <0xbb8>;
		phandle = <0x36>;
	};

	sfp2 {
		compatible = "sff,sfp";
		i2c-bus = <0x40>;
		los-gpios = <0x08 0x02 0x00>;
		mod-def0-gpios = <0x08 0x01 0x01>;
		tx-disable-gpios = <0x08 0x00 0x00>;
		maximum-power-milliwatt = <0xbb8>;
		phandle = <0x78>;
	};

	__symbols__ {
		cci = "/cci";
		cci_opp = "/opp-table-cci";
