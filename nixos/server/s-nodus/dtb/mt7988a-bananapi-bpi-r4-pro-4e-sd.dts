/dts-v1/;

/ {
	compatible = "bananapi,bpi-r4-pro-4e", "bananapi,bpi-r4-pro", "mediatek,mt7988a";
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "Bananapi BPI-R4 Pro 4E";

	cci {
		compatible = "mediatek,mt7988-cci", "mediatek,mt8183-cci";
		clocks = <0x02 0x00 0x03 0x00>;
		clock-names = "cci", "intermediate";
		operating-points-v2 = <0x04>;
		proc-supply = <0x05>;
		phandle = <0x07>;
	};

	opp-table-cci {
		compatible = "operating-points-v2";
		opp-shared;
		phandle = <0x04>;

		opp-480000000 {
			opp-hz = <0x00 0x1c9c3800>;
			opp-microvolt = <0xcf850>;
		};

		opp-660000000 {
			opp-hz = <0x00 0x2756cd00>;
			opp-microvolt = <0xcf850>;
		};

		opp-900000000 {
			opp-hz = <0x00 0x35a4e900>;
			opp-microvolt = <0xcf850>;
		};

		opp-1080000000 {
			opp-hz = <0x00 0x405f7e00>;
			opp-microvolt = <0xdbba0>;
		};
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			compatible = "arm,cortex-a73";
			reg = <0x00>;
			device_type = "cpu";
			enable-method = "psci";
			clocks = <0x02 0x01 0x03 0x00>;
			clock-names = "cpu", "intermediate";
			operating-points-v2 = <0x06>;
			mediatek,cci = <0x07>;
			proc-supply = <0x05>;
			phandle = <0x41>;
		};

		cpu@1 {
			compatible = "arm,cortex-a73";
			reg = <0x01>;
			device_type = "cpu";
			enable-method = "psci";
			clocks = <0x02 0x01 0x03 0x00>;
			clock-names = "cpu", "intermediate";
			operating-points-v2 = <0x06>;
			mediatek,cci = <0x07>;
			proc-supply = <0x05>;
			phandle = <0x42>;
		};

		cpu@2 {
			compatible = "arm,cortex-a73";
			reg = <0x02>;
			device_type = "cpu";
			enable-method = "psci";
			clocks = <0x02 0x01 0x03 0x00>;
			clock-names = "cpu", "intermediate";
			operating-points-v2 = <0x06>;
			mediatek,cci = <0x07>;
			proc-supply = <0x05>;
			phandle = <0x43>;
		};

		cpu@3 {
			compatible = "arm,cortex-a73";
			reg = <0x03>;
			device_type = "cpu";
			enable-method = "psci";
			clocks = <0x02 0x01 0x03 0x00>;
			clock-names = "cpu", "intermediate";
			operating-points-v2 = <0x06>;
			mediatek,cci = <0x07>;
			proc-supply = <0x05>;
			phandle = <0x44>;
		};

		opp-table-0 {
			compatible = "operating-points-v2";
			opp-shared;
			phandle = <0x06>;

			opp-800000000 {
				opp-hz = <0x00 0x2faf0800>;
				opp-microvolt = <0xcf850>;
			};

			opp-1100000000 {
				opp-hz = <0x00 0x4190ab00>;
				opp-microvolt = <0xcf850>;
			};

			opp-1500000000 {
				opp-hz = <0x00 0x59682f00>;
				opp-microvolt = <0xcf850>;
			};

			opp-1800000000 {
				opp-hz = <0x00 0x6b49d200>;
				opp-microvolt = <0xdbba0>;
			};
		};
	};

	oscillator-40m {
		compatible = "fixed-clock";
		clock-frequency = <0x2625a00>;
		#clock-cells = <0x00>;
		clock-output-names = "clkxtal";
	};

	pmu {
		compatible = "arm,cortex-a73-pmu";
		interrupt-parent = <0x01>;
		interrupts = <0x01 0x07 0x08>;
	};

	psci {
		compatible = "arm,psci-0.2";
		method = "smc";
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		secmon@43000000 {
			reg = <0x00 0x43000000 0x00 0x50000>;
			no-map;
		};
	};

	soc {
		compatible = "simple-bus";
		ranges;
		#address-cells = <0x02>;
		#size-cells = <0x02>;

		interrupt-controller@c000000 {
			compatible = "arm,gic-v3";
			reg = <0x00 0xc000000 0x00 0x40000 0x00 0xc080000 0x00 0x200000 0x00 0xc400000 0x00 0x2000 0x00 0xc410000 0x00 0x1000 0x00 0xc420000 0x00 0x2000>;
			interrupt-parent = <0x01>;
			interrupts = <0x01 0x09 0x04>;
			interrupt-controller;
			#interrupt-cells = <0x03>;
			phandle = <0x01>;
		};

		clock-controller@10001000 {
			compatible = "mediatek,mt7988-infracfg", "syscon";
			reg = <0x00 0x10001000 0x00 0x1000>;
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			phandle = <0x09>;
		};

		clock-controller@1001b000 {
			compatible = "mediatek,mt7988-topckgen", "syscon";
			reg = <0x00 0x1001b000 0x00 0x1000>;
			#clock-cells = <0x01>;
			phandle = <0x03>;
		};

		watchdog@1001c000 {
			compatible = "mediatek,mt7988-wdt";
			reg = <0x00 0x1001c000 0x00 0x1000>;
			interrupts = <0x00 0x6e 0x04>;
			#reset-cells = <0x01>;
			status = "okay";
			phandle = <0x21>;
		};

		clock-controller@1001e000 {
			compatible = "mediatek,mt7988-apmixedsys";
			reg = <0x00 0x1001e000 0x00 0x1000>;
			#clock-cells = <0x01>;
			phandle = <0x15>;
		};

		pinctrl@1001f000 {
			compatible = "mediatek,mt7988-pinctrl";
			reg = <0x00 0x1001f000 0x00 0x1000 0x00 0x11c10000 0x00 0x1000 0x00 0x11d00000 0x00 0x1000 0x00 0x11d20000 0x00 0x1000 0x00 0x11e00000 0x00 0x1000 0x00 0x11f00000 0x00 0x1000 0x00 0x1000b000 0x00 0x1000>;
			reg-names = "gpio", "iocfg_tr", "iocfg_br", "iocfg_rb", "iocfg_lb", "iocfg_tl", "eint";
			gpio-controller;
			#gpio-cells = <0x02>;
			gpio-ranges = <0x08 0x00 0x00 0x54>;
			interrupt-controller;
			interrupts = <0x00 0xe1 0x04>;
			interrupt-parent = <0x01>;
			#interrupt-cells = <0x02>;
			phandle = <0x08>;

			pcie0-pins {
				phandle = <0x1b>;

				mux {
					function = "pcie";
					groups = "pcie_2l_0_pereset", "pcie_clk_req_n0_0", "pcie_wake_n0_0";
				};
			};

			pcie1-pins {
				phandle = <0x1d>;

				mux {
					function = "pcie";
					groups = "pcie_2l_1_pereset", "pcie_clk_req_n1", "pcie_wake_n1_0";
				};
			};

			pcie2-pins {
				phandle = <0x16>;

				mux {
					function = "pcie";
					groups = "pcie_1l_0_pereset", "pcie_clk_req_n2_0", "pcie_wake_n2_0";
				};
			};

			pcie3-pins {
				phandle = <0x19>;

				mux {
					function = "pcie";
					groups = "pcie_1l_1_pereset", "pcie_clk_req_n3", "pcie_wake_n3_0";
				};
			};

			spi1-pins {
				phandle = <0x10>;

				mux {
					function = "spi";
					groups = "spi1";
				};
			};

			uart0-pins {
				phandle = <0x0a>;

				mux {
					function = "uart";
					groups = "uart0";
				};
			};

			gbe0-led0-pins {
				phandle = <0x29>;

				mux {
					function = "led";
					groups = "gbe0_led0";
				};
			};

			i2c0-g0-pins {
				phandle = <0x0b>;

				mux {
					function = "i2c";
					groups = "i2c0_1";
				};
			};

			i2c1-g0-pins {
				phandle = <0x0d>;

				mux {
					function = "i2c";
					groups = "i2c1_0";
				};
			};

			i2c2-g1-pins {
				phandle = <0x0e>;

				mux {
					function = "i2c";
					groups = "i2c2_1";
				};
			};

			mdio0-pins {
				phandle = <0x30>;

				mux {
					function = "eth";
					groups = "mdc_mdio0";
				};

				conf {
					pins = "SMI_0_MDC", "SMI_0_MDIO";
					drive-strength = <0x08>;
				};
			};

			mmc0-emmc-51-pins {
				phandle = <0x45>;

				mux {
					function = "flash";
					groups = "emmc_51";
				};
			};

			mmc0-sdcard-pins {
				phandle = <0x46>;

				mux {
					function = "flash";
					groups = "sdcard";
				};
			};

			pcie-2-hog {
				gpio-hog;
				gpios = <0x4f 0x00>;
			};

			pcie-3-hog {
				gpio-hog;
				gpios = <0x3f 0x00>;
			};

			pwm0-pins {
				phandle = <0x3c>;

				mux {
					groups = "pwm0";
					function = "pwm";
				};
			};

			spi0-flash-pins {
				phandle = <0x0f>;

				mux {
					function = "spi";
					groups = "spi0", "spi0_wp_hold";
				};
			};

			gbe1-led0-pins {
				phandle = <0x2b>;

				mux {
					function = "led";
					groups = "gbe1_led0";
				};
			};

			gbe2-led0-pins {
				phandle = <0x47>;

				mux {
					function = "led";
					groups = "gbe2_led0";
				};
			};

			gbe3-led0-pins {
				phandle = <0x48>;

				mux {
					function = "led";
					groups = "gbe3_led0";
				};
			};
		};

		pwm@10048000 {
			compatible = "mediatek,mt7988-pwm";
			reg = <0x00 0x10048000 0x00 0x1000>;
			clocks = <0x09 0x19 0x09 0x18 0x09 0x1a 0x09 0x1b 0x09 0x1c 0x09 0x1d 0x09 0x1e 0x09 0x1f 0x09 0x20 0x09 0x21>;
			clock-names = "top", "main", "pwm1", "pwm2", "pwm3", "pwm4", "pwm5", "pwm6", "pwm7", "pwm8";
			#pwm-cells = <0x02>;
			status = "okay";
			phandle = <0x3d>;
		};

		mcusys@100e0000 {
			compatible = "mediatek,mt7988-mcusys", "syscon";
			reg = <0x00 0x100e0000 0x00 0x1000>;
			#clock-cells = <0x01>;
			phandle = <0x02>;
		};

		/*
		 * SGMII / USXGMII SerDes PCS blocks.  The MACs bind these via
		 * pcs-handle; without them mtk_eth_soc logs
		 *   eth1: couldn't find a PCS for 10gbase-r
		 * and no WAN / MxL-CPU link comes up.  Node text mirrors the
		 * vendor / ly4096x board DTB.  The resets reference the
		 * TOPRGU (watchdog) reset controller (our phandle 0x21), NOT
		 * ethwarp: TOPRGU indices are SGMII0=1, SGMII1=2, XFI0=0x0c,
		 * XFI1=0x0d (MT7988_TOPRGU_SW_RST_NUM=24).
		 */
		syscon@10060000 {
			compatible = "mediatek,mt7988-sgmiisys", "mediatek,mt7988-sgmiisys0", "syscon", "simple-mfd";
			reg = <0x00 0x10060000 0x00 0x1000>;
			resets = <0x21 0x01>;
			#clock-cells = <0x01>;
			phandle = <0x80>;

			pcs {
				compatible = "mediatek,mt7988-sgmii";
				clocks = <0x03 0x43 0x80 0x00 0x80 0x01>;
				clock-names = "sgmii_sel", "sgmii_tx", "sgmii_rx";
				phys = <0x5e>;
				#pcs-cells = <0x00>;
				phandle = <0x81>;
			};
		};

		syscon@10070000 {
			compatible = "mediatek,mt7988-sgmiisys", "mediatek,mt7988-sgmiisys1", "syscon", "simple-mfd";
			reg = <0x00 0x10070000 0x00 0x1000>;
			resets = <0x21 0x02>;
			#clock-cells = <0x01>;
			phandle = <0x82>;

			pcs {
				compatible = "mediatek,mt7988-sgmii";
				clocks = <0x03 0x45 0x82 0x00 0x82 0x01>;
				clock-names = "sgmii_sel", "sgmii_tx", "sgmii_rx";
				phys = <0x5f>;
				#pcs-cells = <0x00>;
				phandle = <0x83>;
			};
		};

		pcs@10080000 {
			compatible = "mediatek,mt7988-usxgmiisys";
			reg = <0x00 0x10080000 0x00 0x1000>;
			resets = <0x21 0x0c>;
			clocks = <0x03 0x41>;
			phys = <0x5e>;
			#pcs-cells = <0x00>;
			phandle = <0x84>;
		};

		pcs@10081000 {
			compatible = "mediatek,mt7988-usxgmiisys";
			reg = <0x00 0x10081000 0x00 0x1000>;
			resets = <0x21 0x0d>;
			clocks = <0x03 0x42>;
			phys = <0x5f>;
			#pcs-cells = <0x00>;
			phandle = <0x85>;
		};

		serial@11000000 {
			compatible = "mediatek,mt7988-uart", "mediatek,mt6577-uart";
			reg = <0x00 0x11000000 0x00 0x100>;
			interrupts = <0x00 0x7b 0x04>;
			interrupt-names = "uart", "wakeup";
			clocks = <0x03 0x27 0x09 0x2f>;
			clock-names = "baud", "bus";
			pinctrl-names = "default";
			pinctrl-0 = <0x0a>;
			status = "okay";
			phandle = <0x49>;
		};

		serial@11000100 {
			compatible = "mediatek,mt7988-uart", "mediatek,mt6577-uart";
			reg = <0x00 0x11000100 0x00 0x100>;
			interrupts = <0x00 0x7c 0x04>;
			interrupt-names = "uart", "wakeup";
			clocks = <0x03 0x27 0x09 0x30>;
			clock-names = "baud", "bus";
			status = "disabled";
		};

		serial@11000200 {
			compatible = "mediatek,mt7988-uart", "mediatek,mt6577-uart";
			reg = <0x00 0x11000200 0x00 0x100>;
			interrupts = <0x00 0x7d 0x04>;
			interrupt-names = "uart", "wakeup";
			clocks = <0x03 0x27 0x09 0x31>;
			clock-names = "baud", "bus";
			status = "disabled";
		};

		i2c@11003000 {
			compatible = "mediatek,mt7981-i2c";
			reg = <0x00 0x11003000 0x00 0x1000 0x00 0x10217080 0x00 0x80>;
			interrupts = <0x00 0x88 0x04>;
			clock-div = <0x01>;
			clocks = <0x09 0x2e 0x09 0x2a>;
			clock-names = "main", "dma";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "okay";
			pinctrl-0 = <0x0b>;
			pinctrl-names = "default";
			phandle = <0x4a>;

			rt5190a@64 {
				compatible = "richtek,rt5190a";
				reg = <0x64>;
				vin2-supply = <0x0c>;
				vin3-supply = <0x0c>;
				vin4-supply = <0x0c>;
				phandle = <0x4b>;

				regulators {

					buck1 {
						regulator-name = "rt5190a-buck1";
						regulator-min-microvolt = <0x4daad0>;
						regulator-max-microvolt = <0x4daad0>;
						regulator-allowed-modes = <0x00 0x01>;
						regulator-boot-on;
						regulator-always-on;
						phandle = <0x0c>;
					};

					buck2 {
						regulator-name = "vcore";
						regulator-min-microvolt = <0x927c0>;
						regulator-max-microvolt = <0x155cc0>;
						regulator-boot-on;
						regulator-always-on;
					};

					buck3 {
						regulator-name = "vproc";
						regulator-min-microvolt = <0x927c0>;
						regulator-max-microvolt = <0x155cc0>;
						regulator-boot-on;
						regulator-always-on;
						phandle = <0x05>;
					};

					buck4 {
						regulator-name = "rt5190a-buck4";
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
						regulator-allowed-modes = <0x00 0x01>;
						regulator-boot-on;
						regulator-always-on;
					};

					ldo {
						regulator-name = "rt5190a-ldo";
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
						regulator-boot-on;
						regulator-always-on;
					};
				};
			};
		};

		i2c@11004000 {
			compatible = "mediatek,mt7981-i2c";
			reg = <0x00 0x11004000 0x00 0x1000 0x00 0x10217100 0x00 0x80>;
			interrupts = <0x00 0x90 0x04>;
			clock-div = <0x01>;
			clocks = <0x09 0x2e 0x09 0x2a>;
			clock-names = "main", "dma";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "okay";
			pinctrl-0 = <0x0d>;
			pinctrl-names = "default";
			phandle = <0x4c>;
		};

		i2c@11005000 {
			compatible = "mediatek,mt7981-i2c";
			reg = <0x00 0x11005000 0x00 0x1000 0x00 0x10217180 0x00 0x80>;
			interrupts = <0x00 0x91 0x04>;
			clock-div = <0x01>;
			clocks = <0x09 0x2e 0x09 0x2a>;
			clock-names = "main", "dma";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "okay";
			pinctrl-0 = <0x0e>;
			pinctrl-names = "default";
			phandle = <0x4d>;

			i2c-mux@70 {
				compatible = "nxp,pca9545";
				reg = <0x70>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				phandle = <0x4e>;

				i2c@0 {
					reg = <0x00>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					phandle = <0x4f>;

					i2c-gpio-expander@20 {
						compatible = "nxp,pca9555";
						reg = <0x20>;
						gpio-controller;
						#gpio-cells = <0x02>;
						phandle = <0x3e>;
					};

					rtc@51 {
						compatible = "nxp,pcf8563";
						reg = <0x51>;
					};

					eeprom@57 {
						compatible = "atmel,24c02";
						reg = <0x57>;
						address-width = <0x08>;
						pagesize = <0x08>;
						size = <0x100>;
					};
				};

				i2c@1 {
					reg = <0x01>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					phandle = <0x3f>;
				};

				i2c@2 {
					reg = <0x02>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					phandle = <0x40>;
				};

				i2c@3 {
					reg = <0x03>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					phandle = <0x50>;
				};
			};
		};

		spi@11007000 {
			compatible = "mediatek,mt7988-spi-quad", "mediatek,spi-ipm";
			reg = <0x00 0x11007000 0x00 0x100>;
			interrupts = <0x00 0x8c 0x04>;
			clocks = <0x03 0x04 0x03 0x2a 0x09 0x35 0x09 0x38>;
			clock-names = "parent-clk", "sel-clk", "spi-clk", "hclk";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "okay";
			pinctrl-0 = <0x0f>;
			pinctrl-names = "default";
			phandle = <0x51>;

			nand@0 {
				compatible = "spi-nand";
				reg = <0x00>;
				spi-max-frequency = <0x3197500>;
				spi-rx-bus-width = <0x04>;
				spi-tx-bus-width = <0x04>;
				phandle = <0x52>;

				partitions {
					compatible = "fixed-partitions";
					#address-cells = <0x01>;
					#size-cells = <0x01>;

					partition@0 {
						reg = <0x00 0x200000>;
						label = "bl2";
					};

					partition@200000 {
						compatible = "linux,ubi";
						reg = <0x200000 0xfe00000>;
						label = "ubi";
					};
				};
			};
		};

		spi@11008000 {
			compatible = "mediatek,mt7988-spi-single", "mediatek,spi-ipm";
			reg = <0x00 0x11008000 0x00 0x100>;
			interrupts = <0x00 0x8d 0x04>;
			clocks = <0x03 0x04 0x03 0x2b 0x09 0x36 0x09 0x39>;
			clock-names = "parent-clk", "sel-clk", "spi-clk", "hclk";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			pinctrl-names = "default";
