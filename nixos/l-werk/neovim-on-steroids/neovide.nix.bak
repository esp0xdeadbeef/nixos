
 { config, pkgs, ... }:

{
  programs.nixvim = {
    enable = true;
    defaultEditor = true;
    extraPackages = with pkgs; [
      git
      curl
      lua5_1
      lua51Packages.luarocks
      readline
      imagemagick
      pkg-config
      imagemagick.dev
    ];
    extraConfigLua = builtins.readFile ./nvim.lua;
    # extraWrapperArgs = [
    #   "--set"
    #   "PKG_CONFIG_PATH"
    #   "${magickDev}/lib/pkgconfig"
    #   "--set"
    #   "PATH"
    #   "${pkgs.imagemagick}/bin:${magickDev}/bin:${pkgs.pkg-config}/bin:$PATH"
    # ];

  };

  environment.systemPackages = with pkgs; [
    neovide
  ];
}
