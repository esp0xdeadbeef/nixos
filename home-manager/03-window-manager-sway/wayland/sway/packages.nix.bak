{ config, pkgs, ... }:

{
  # Packages related to Sway
  home.packages = with pkgs; [
    # sway itself:
    sway
    # lock screen
    swaylock
    # ??
    swayidle
    # rofi includes Wayland support on current nixpkgs:
    rofi
    wofi
    # Notification daemon for Wayland
    mako
    # simular to xclip 
    wl-clipboard
    # brightness
    brightnessctl
    # audio
    pavucontrol
    # screenshot tooling:
    grim
    slurp
    # terminal (just to be sure)
    alacritty
  ];
}
